# Copy to .env and fill in. Never commit .env.

# Steam Web API key (free): https://steamcommunity.com/dev/apikey — used for GetNewsForApp (patch notes)
STEAM_API_KEY=

# Optional contact (URL or email) added to the User-Agent sent to public APIs like Fandom
SGA_HTTP_CONTACT=

# LLM provider: "ollama" (default, the local container below) or "openai" (any OpenAI-compatible
# endpoint). The hosted deploy uses Cloudflare Workers AI:
#   SGA_LLM_PROVIDER=openai
#   SGA_LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<account id>/ai/v1
#   SGA_LLM_API_KEY=<API token with Workers AI read permission>
#   SGA_LLM_MODEL=@cf/qwen/qwen3-30b-a3b-fp8   (replace the SGA_LLM_MODEL line below, don't add one)
# Only the agent and the UI use the hosted model; `sga ask`, `sga train aspect-labels` and
# `sga eval synth` always call Ollama with SGA_LLM_MODEL / SGA_LLM_DEV_MODEL.
SGA_LLM_PROVIDER=ollama
SGA_LLM_BASE_URL=
SGA_LLM_API_KEY=

# LLMs served by the ollama container
SGA_LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
SGA_LLM_DEV_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_KEEP_ALIVE=10m

# Embedding / reranking models (HF ids, cached under ./models/hf)
SGA_EMBED_MODEL=BAAI/bge-m3
SGA_RERANK_MODEL=BAAI/bge-reranker-base

# Subset selection (see configs/pipeline.yaml for the rest)
SGA_SUBSET_GAMES=300
SGA_REVIEWS_PER_GAME=1500
